+    private static bool CanProcurePotion(Player player, PotionModel potion) =>
+        MegaCrit.Sts2.Core.Hooks.Hook.ShouldProcurePotion(player.RunState, player.Creature.CombatState, potion, player);
+
+    private bool CanManuallyUsePotion(Player player, PotionModel potion)
+    {
+        if (potion.IsQueued || player.Creature.IsDead || !player.CanUseOrRemovePotions
+            || !potion.PassesCustomUsabilityCheck || _cardSelector.HasPending || _cardSelector.HasPendingReward)
+            return false;
+        return potion.Usage.ToString() == "AnyTime"
+            || (potion.Usage.ToString() == "CombatOnly" && CombatManager.Instance.IsInProgress
+                && CombatManager.Instance.DebugOnlyGetState()?.CurrentSide == CombatSide.Player);
+    }
+
+    private Dictionary<string, object?> PotionRewardState(Player player)
+    {
+        var reward = _pendingPotionRewards.Peek();
+        var potion = reward.Potion!;
+        return new Dictionary<string, object?>
+        {
+            ["type"] = "decision", ["decision"] = "potion_reward", ["context"] = RunContext(),
+            ["potion"] = new Dictionary<string, object?> {
+                ["id"] = potion.Id.Entry, ["name"] = _loc.Potion(potion.Id.Entry),
+                ["description"] = _loc.Bilingual("potions", potion.Id.Entry + ".description"),
+                ["target_type"] = potion.TargetType.ToString(), ["usage"] = potion.Usage.ToString(),
+                ["vars"] = potion.DynamicVars.Values.ToDictionary(v => v.Name, v => (int)v.BaseValue)
+            },
+            ["can_claim"] = player.HasOpenPotionSlots && CanProcurePotion(player, potion),
+            ["can_skip"] = true, ["player"] = PlayerSummary(player)
+        };
+    }
+
+    private Dictionary<string, object?> DoPotionReward(Player player, bool skip)
+    {
+        if (!_resourceDecisions || _pendingPotionRewards.Count == 0) return Error("No pending potion reward");
+        var reward = _pendingPotionRewards.Peek();
+        if (skip) reward.OnSkipped();
+        else
+        {
+            if (!player.HasOpenPotionSlots || !CanProcurePotion(player, reward.Potion!))
+                return Error("Potion reward cannot be procured");
+            reward.SelectUnsynchronized().GetAwaiter().GetResult();
+            _syncCtx.Pump();
+            if (reward.ClaimedPotion == null || !player.Potions.Contains(reward.ClaimedPotion))
+                return Error("Potion reward was not procured; inspect state before retrying");
+        }
+        _pendingPotionRewards.Dequeue();
+        return DetectDecisionPoint();
+    }
+
     private Dictionary<string, object?> PlayerSummary(Player player)
+    {
+        var summary = LegacyPlayerSummary(player);
+        if (!_resourceDecisions) return summary;
+        summary["potion_capacity"] = player.MaxPotionCount;
+        summary["has_open_potion_slots"] = player.HasOpenPotionSlots;
+        summary["can_use_or_remove_potions"] = player.CanUseOrRemovePotions;
+        var potions = player.Potions.ToList();
+        var exported = (List<Dictionary<string, object?>?>)summary["potions"]!;
+        for (int i = 0; i < potions.Count; i++)
+        {
+            var potion = potions[i]; var item = exported[i]!;
+            item["id"] = potion.Id.Entry;
+            item["slot_index"] = player.PotionSlots.ToList().IndexOf(potion);
+            item["usage"] = potion.Usage.ToString();
+            item["can_use"] = CanManuallyUsePotion(player, potion);
+            item["can_discard"] = player.CanUseOrRemovePotions && !potion.IsQueued && !player.Creature.IsDead;
+        }
+        return summary;
+    }
