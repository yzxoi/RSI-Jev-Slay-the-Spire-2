+    private bool WaitForStablePlayerBoundary(Player player)
+    {
+        string? previous = null;
+        long stableSince = Environment.TickCount64;
+        for (int attempt = 0; attempt < 2000; attempt++)
+        {
+            _syncCtx.Pump();
+            if (_cardSelector.HasPending || _cardSelector.HasPendingReward || !CombatManager.Instance.IsInProgress || player.Creature.IsDead) return false;
+            try
+            {
+                var pcs = player.PlayerCombatState;
+                var state = CombatManager.Instance.DebugOnlyGetState();
+                var settled = IsPlayPhase() && !CombatManager.Instance.PlayerActionsDisabled
+                    && RunManager.Instance.ActionExecutor.CurrentlyRunningAction == null
+                    && RunManager.Instance.ActionQueueSet.GetReadyAction() == null;
+                var cards = pcs.Hand.Cards.ToArray();
+                var signature = $"{state?.RoundNumber}|{pcs.Energy}|{pcs.Stars}|{player.Creature.Block}|{cards.Length}|" + string.Join(",", cards.Select(c => c.Id.Entry));
+                if (settled && signature == previous)
+                {
+                    if (Environment.TickCount64 - stableSince >= 30) return true;
+                }
+                else { previous = settled ? signature : null; stableSince = Environment.TickCount64; }
+            }
+            catch (InvalidOperationException) { previous = null; stableSince = Environment.TickCount64; }
+            Thread.Sleep(1);
+        }
+        throw new TimeoutException("Combat never reached a stable actionable boundary; no action retried");
+    }
