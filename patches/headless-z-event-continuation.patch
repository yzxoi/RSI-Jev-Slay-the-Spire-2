+            _syncCtx.Pump();
+            if (_eventChoiceTask.IsCompleted)
+            {
+                var finished = _eventChoiceTask;
+                _eventChoiceTask = null;
+                finished.GetAwaiter().GetResult();
+                return;
+            }
+            if (_cardSelector.HasPending || _cardSelector.HasPendingReward || _pendingBundles != null) return;
+            if (Environment.TickCount64 >= deadline)
+                throw new TimeoutException("Event continuation did not reach a boundary; action was not retried");
+            Thread.Sleep(1);
+        }
+    }
